{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist/types/tycho",
    "rootDir": "src",
    "types": [],
    "skipLibCheck": true
  },
  "include": ["src"]
}
